for i in range(int(input())):
    n, k = map(int , input().split())
    arr = list(map(int , input().split()))
    arr.sort()
    left = 0
    right = n-1
    count=0
    while left < right :
        if arr[left]+arr[right] == k:
            count+=1
            left+=1
            right-=1
        elif arr[left]+arr[right] < k :
            left+=1
        else:
            right-=1
    print(count)             
